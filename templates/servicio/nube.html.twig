{% extends 'servicio/_servicio.html.twig' %}

{% block servicio_clave %}nube{% endblock %}

{% block servicio_titulo %}Infraestructura en la nube{% endblock %}

{% block servicio_resumen %}
    Brindamos un conjunto de soluciones de infraestructura en la nube que garantizan la disponibilidad de sus
    aplicaciones y servicios.
{% endblock %}

{% block servicio_contenido %}
    <p>La infraestructura de nube reúne los elementos necesarios para alojar aplicaciones y servicios de forma remota:
        servidores, recursos virtualizados, almacenamiento y red. Nosotros la administramos para que su equipo se
        concentre en su operación.</p>

    <h3 class="servicio-subtitulo">Componentes que administramos</h3>
    <div class="row">
        <div class="col-md-6 d-flex">
            <div class="servicio-tarjeta">
                <i class="fas fa-server"></i>
                <h4>Hardware</h4>
                <p>Servidores y equipos de red —enrutadores, firewalls y balanceadores de carga— distribuidos en
                    distintas regiones.</p>
            </div>
        </div>
        <div class="col-md-6 d-flex">
            <div class="servicio-tarjeta">
                <i class="fas fa-clone"></i>
                <h4>Virtualización</h4>
                <p>Separa los servicios del hardware físico y permite ajustar memoria, procesamiento y almacenamiento
                    según la demanda.</p>
            </div>
        </div>
        <div class="col-md-6 d-flex">
            <div class="servicio-tarjeta">
                <i class="fas fa-hdd"></i>
                <h4>Almacenamiento</h4>
                <p>Copias de seguridad periódicas, depuración de copias obsoletas y recuperación de datos ante
                    cualquier falla.</p>
            </div>
        </div>
        <div class="col-md-6 d-flex">
            <div class="servicio-tarjeta">
                <i class="fas fa-network-wired"></i>
                <h4>Red</h4>
                <p>Redes virtuales con distintos niveles de control y acceso remoto seguro a sus aplicaciones, cuando
                    las necesite.</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block servicio_extra %}
    {% set planes = [
        {'nombre': 'Básico', 'precio': 30, 'incluye': ['4 GB RAM / 2 CPU Intel', '80 GB SSD NVMe', '4 TB de transferencia'], 'excluye': ['Soporte 24/7', 'Cancelación gratuita']},
        {'nombre': 'Medio', 'precio': 60, 'incluye': ['8 GB RAM / 4 CPU Intel', '160 GB SSD NVMe', '5 TB de transferencia', 'Soporte 5/8', 'Cancelación gratuita'], 'excluye': [], 'destacado': true},
        {'nombre': 'Premium', 'precio': 120, 'incluye': ['16 GB RAM / 8 CPU Intel', '320 GB SSD NVMe', '6 TB de transferencia', 'Soporte 5/8', 'Cancelación gratuita'], 'excluye': []},
    ] %}
    <section class="planes-area section-padding bg-grey">
        <div class="container">
            <div class="section-title">
                <span class="seccion-etiqueta">Planes</span>
                <h2>Elija el plan para su infraestructura</h2>
            </div>
            <div class="row justify-content-center">
                {% for plan in planes %}
                    <div class="col-lg-4 col-md-6 d-flex">
                        <div class="plan{% if plan.destacado ?? false %} plan-destacado{% endif %}">
                            {% if plan.destacado ?? false %}<span class="plan-insignia">Recomendado</span>{% endif %}
                            <h3>{{ plan.nombre }}</h3>
                            <div class="plan-precio"><small>$</small> {{ plan.precio }} <span>/ mes</span></div>
                            <ul>
                                {% for item in plan.incluye %}
                                    <li><i class="fas fa-check-circle"></i> {{ item }}</li>
                                {% endfor %}
                                {% for item in plan.excluye %}
                                    <li class="plan-no"><i class="fas fa-times-circle"></i> {{ item }}</li>
                                {% endfor %}
                            </ul>
                            <a href="{{ path('contacto') }}" class="{{ (plan.destacado ?? false) ? 'default-btn' : 'default-btn-one' }}">Contratar <span></span></a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
