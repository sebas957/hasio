{# Ilustracion propia del ecosistema Semantica ERP (sin imagenes de terceros) #}
<svg class="ecosistema" viewBox="0 0 520 480" role="img" aria-labelledby="ecosistema-titulo">
    <title id="ecosistema-titulo">Semantica ERP conecta finanzas, compras, ventas, nómina, inventario y logística</title>
    <defs>
        <linearGradient id="eco-degradado" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3681c4"/>
            <stop offset="1" stop-color="#143049"/>
        </linearGradient>
        <pattern id="eco-puntos" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.4" fill="#c9d8ea"/>
        </pattern>
        <filter id="eco-sombra" x="-20%" y="-30%" width="140%" height="180%">
            <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#0d2547" flood-opacity="0.12"/>
        </filter>
    </defs>

    <rect x="0" y="0" width="520" height="480" rx="20" fill="#eef5fc"/>
    <rect x="0" y="0" width="520" height="480" rx="20" fill="url(#eco-puntos)" opacity="0.7"/>

    {# Conexiones #}
    <g class="eco-lineas" stroke="#3681c4" stroke-width="1.6" stroke-dasharray="5 6" fill="none" opacity="0.55">
        <line x1="260" y1="240" x2="260" y2="75"/>
        <line x1="260" y1="240" x2="420" y2="157"/>
        <line x1="260" y1="240" x2="420" y2="323"/>
        <line x1="260" y1="240" x2="260" y2="405"/>
        <line x1="260" y1="240" x2="100" y2="323"/>
        <line x1="260" y1="240" x2="100" y2="157"/>
    </g>

    {# Nucleo #}
    <circle cx="260" cy="240" r="98" fill="none" stroke="#3681c4" stroke-opacity="0.25" stroke-width="1.5"/>
    <circle cx="260" cy="240" r="72" fill="url(#eco-degradado)" filter="url(#eco-sombra)"/>
    <text x="260" y="234" text-anchor="middle" class="eco-nucleo">Semantica</text>
    <text x="260" y="258" text-anchor="middle" class="eco-nucleo-sub">ERP</text>

    {# Modulos: x, y, icono Font Awesome, nombre #}
    {% set modulos = [
        [260, 75, 'f201', 'Finanzas'],
        [420, 157, 'f07a', 'Compras'],
        [420, 323, 'f571', 'Ventas'],
        [260, 405, 'f0c0', 'Nómina'],
        [100, 323, 'f468', 'Inventario'],
        [100, 157, 'f0d1', 'Logística'],
    ] %}
    {% for m in modulos %}
        <g transform="translate({{ m[0] - 62 }}, {{ m[1] - 21 }})" filter="url(#eco-sombra)">
            <rect width="124" height="42" rx="21" fill="#fff"/>
            <circle cx="21" cy="21" r="14" fill="#eef5fc"/>
            <text x="21" y="25.5" text-anchor="middle" class="eco-icono">&#x{{ m[2] }};</text>
            <text x="43" y="26" class="eco-modulo">{{ m[3] }}</text>
        </g>
    {% endfor %}

    {# Insignia de nube #}
    <g transform="translate(386, 24)">
        <rect width="112" height="30" rx="15" fill="#143049"/>
        <text x="22" y="20" text-anchor="middle" class="eco-icono eco-icono-claro">&#xf0c2;</text>
        <text x="38" y="19.5" class="eco-insignia">En la nube</text>
    </g>
</svg>
