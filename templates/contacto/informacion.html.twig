{% extends 'base_claro.html.twig' %}
{% block content %}

    <section class="contacto-gracias">
        <div class="container">
            <div class="contacto-gracias-caja">
                <span class="contacto-gracias-icono"><i class="fas fa-check"></i></span>
                <h1>¡Gracias por escribirnos!</h1>
                <p>Recibimos su mensaje. Uno de nuestros asesores se comunicará con usted para ampliar la información.</p>
                <div class="contacto-radicado">
                    <span>Número de radicado</span>
                    <strong>#{{ codigoContacto }}</strong>
                </div>
                <div class="contacto-gracias-botones">
                    <a href="{{ path('inicio') }}" class="default-btn">Volver al inicio <span></span></a>
                    <a href="{{ path('producto_erp') }}" class="default-btn-one">Conocer Semantica ERP <span></span></a>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
