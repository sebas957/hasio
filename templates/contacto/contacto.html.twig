{% extends 'base.html.twig' %}
{% block content %}
    {{ include('_cabecera.html.twig', {'titulo': 'Contacto', 'descripcion': 'Hable con un asesor comercial sobre su proyecto.', 'migas': [{'texto': 'Inicio', 'url': path('inicio')}, {'texto': 'Contacto'}]}) }}

    <!-- Start Contact Section -->
    <section class="contacto-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="contacto-intro">
                        <span class="seccion-etiqueta">Contacto</span>
                        <h2>Hablemos de su proyecto</h2>
                        <p>Déjenos sus datos y un asesor comercial se comunicará con usted para ampliar la información.</p>
                    </div>
                    <ul class="contacto-datos">
                        <li>
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <h3>Dirección</h3>
                                <p>Calle 34 # 66 A 33, oficina 201, Conquistadores<br>Medellín, Antioquia, Colombia</p>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-phone"></i>
                            <div>
                                <h3>Teléfono</h3>
                                <p><a href="tel:+573125829803">+57 312 5829803</a></p>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-envelope"></i>
                            <div>
                                <h3>Correo</h3>
                                <p>
                                    <a href="mailto:administracion@semantica.com.co">administracion@semantica.com.co</a><br>
                                    <a href="mailto:investigacion@semantica.com.co">investigacion@semantica.com.co</a>
                                </p>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-8">
                    <div class="contacto-formulario">
                        {{ include('_avisos.html.twig') }}
                        {{ form_start(form, { 'attr': {'id': 'form_contacto'} }) }}
                        {% if form.vars.errors|length %}
                            <div class="alert alert-danger" role="alert">
                                {% for error in form.vars.errors %}{{ error.message }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                            </div>
                        {% endif %}
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.nombre, 'Nombre completo') }}
                                    {{ form_widget(form.nombre, { 'attr': {'placeholder': 'Ej. Ana Gómez', 'autocomplete': 'name', 'maxlength': 200} }) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.empresa, 'Empresa') }}
                                    {{ form_widget(form.empresa, { 'attr': {'placeholder': 'Nombre de su empresa', 'autocomplete': 'organization', 'maxlength': 200} }) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.correo, 'Correo electrónico') }}
                                    {{ form_widget(form.correo, { 'attr': {'placeholder': 'nombre@empresa.com', 'autocomplete': 'email', 'maxlength': 200} }) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.telefono, 'Teléfono') }}
                                    {{ form_widget(form.telefono, { 'attr': {'placeholder': '+57 300 000 0000', 'autocomplete': 'tel', 'inputmode': 'tel', 'maxlength': 100} }) }}
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    {{ form_label(form.descripcion, '¿En qué podemos ayudarle?') }}
                                    {{ form_widget(form.descripcion, { 'attr': {'placeholder': 'Cuéntenos brevemente sobre su necesidad o proyecto', 'rows': 6, 'maxlength': 2000} }) }}
                                </div>
                            </div>
                        </div>
                        <div class="contacto-enviar">
                            <p class="contacto-privacidad">
                                Al enviar este formulario acepta nuestra
                                <a href="{{ path('soporte_politicas_privacidad') }}">política de privacidad</a>.
                            </p>
                            {{ form_widget(form.guardar, { 'label': 'Enviar mensaje', 'attr': {'class': 'default-btn'} }) }}
                        </div>
                        <input type="hidden" name="recaptcha_token">
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Contact Section -->
{% endblock %}
{% block javascriptsPersonales %}
    {{ include('_recaptcha.html.twig', {'formulario': 'form_contacto', 'accion': 'contacto'}) }}
    <script>
        // Evita dobles envios mientras se obtiene el token y se procesa la solicitud
        document.getElementById('form_contacto').addEventListener('submit', function (evento) {
            var boton = evento.submitter;
            if (boton) {
                boton.classList.add('enviando');
                boton.textContent = 'Enviando…';
            }
        });
    </script>
{% endblock %}
