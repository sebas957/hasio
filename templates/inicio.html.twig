{% extends 'base_claro.html.twig' %}
{% block content %}
    <!-- Start Home Area -->
    <div class="home-area">
        <div class="d-table">
            <div class="d-table-cell">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6 col-md-12">
                            <div class="main-banner-content">
                                <h1>Administre su empresa con nuestras <span
                                            class="color-text">Soluciones nube</span>
                                </h1>
                                <p>Nuestra suite de servicios y productos integrados conecta todos los departamentos de una organización
                                    y afecta a todas las áreas para ayudar a aumentar los ingresos, controlar los gastos,
                                    mejorar la toma de decisiones y transformar los datos en información útil
                                </p>
                                <div class="banner-btn">
                                    <a href="{{ path('nosotros') }}" class="default-btn-one">
                                        Conózcanos
                                        <span></span>
                                    </a>
                                    <a class="default-btn" href="{{ path('contacto') }}">
                                        Contáctenos
                                        <span></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="banner-image">
                                <img src="{{ asset('landingPage/img/home-font.png') }}" alt="logo">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="grey-cr"></div>
    </div>
    <!-- End Home Area -->

    <!-- Start Services Section -->
    <section id="servicios" class="services-section pt-70 pb-100">
        <div class="container">
            <div class="section-title">
                <span class="seccion-etiqueta">Servicios</span>
                <h2>Acompañamos cada etapa de su operación</h2>
            </div>
            <div class="row">
                <div class="col-lg-4 col-md-6">
                    <div class="single-services-item">
                        <div class="services-icon">
                            <i class="fas fa-cloud"></i>
                        </div>
                        <h3>Servicios nube</h3>
                        <p>Garantice el éxito y optimo funcionamiento de sus aplicaciones con nuestras soluciones de infraestructura.</p>
                        <div class="services-btn-link">
                            <a href="{{ path('servicio', {'servicio': 'nube'}) }}" class="services-link">Leer más</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="single-services-item">
                        <div class="services-icon">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h3>Soporte técnico</h3>
                        <p>Un equipo de profesionales preparados para guiarlo en el uso de nuestros productos y servicios</p>
                        <div class="services-btn-link">
                            <a href="{{ path('servicio', {'servicio': 'soporte'}) }}" class="services-link">Leer más</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="single-services-item">
                        <div class="services-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h3>Consultoría</h3>
                        <p>Encuentre las fortalezas de su compañía y conviértalas en ventajas competitivas alineadas a su sector</p>
                        <div class="services-btn-link">
                            <a href="{{ path('servicio', {'servicio': 'consultoria'}) }}" class="services-link">Leer más</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Services Section -->

    <!-- Start Overview Section -->
    <section class="overview-section bg-grey section-padding">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="overview-content">
                        <span class="seccion-etiqueta">Producto</span>
                        <h2>Semantica ERP</h2>
                        <p>Con el software Semantica ERP, centralice todas las áreas y
                            procesos de su compañía, generando información sólida que le permita
                            tomar decisiones acertadas y alineadas con su negocio.</p>
                        <ul class="features-list">
                            <li><span class="active">Finanzas</span></li>
                            <li><span>Compras & Tesoreria</span></li>
                            <li><span>Ventas & Cartera</span></li>
                            <li><span>Recurso humano</span></li>
                            <li><span>Inventario</span></li>
                            <li><span>CRM</span></li>
                            <li><span>Programacion turnos</span></li>
                            <li><span>Logistica & Transporte</span></li>
                        </ul>
                        <div class="overview-btn">
                            <a href="{{ path('producto_erp') }}" class="default-btn-one">Conocer Semantica ERP <span></span></a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="inicio-ilustracion">
                        {% include 'producto/_flujo.svg.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Overview Section -->

    <!-- Start Overview Section -->
    <section class="overview-section section-padding">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="overview-image">
                        <img src="{{ asset('landingPage/img/choose-2.png') }}" alt="logo">
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="overview-content">
                        <span class="seccion-etiqueta">Aliados</span>
                        <h2>Nuestros aliados Semántica</h2>
                        <p>En Semantica contamos con colaboradores de primer nivel,
                            compañías expertas en sectores específicos que enriquecen nuestras soluciones y la calidad de nuestros
                            productos y servicios...</p>
                        <ul class="features-list">
                            <li><span class="active">Esetech Solutions</span></li>
                            <li><span>Digital Ocean</span></li>
                            <li><span>AWS</span></li>
                            <li><span>Azure</span></li>
                            <li><span>ABC Contable y Juridico</span></li>
                            <li><span>Laboratorio Juridico</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Overview Section -->

    <!-- Start Counter Section -->
    <section class="counter-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 counter-item">
                    <div class="single-counter">
                        <div class="counter-contents">
                            <h2>
                                <span class="counter-number">10</span><span>+</span>
                            </h2>
                            <h3 class="counter-heading">Años de experiencia</h3>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 counter-item">
                    <div class="single-counter">
                        <div class="counter-contents">
                            <h2>
                                <span class="counter-number">80</span>
                            </h2>
                            <h3 class="counter-heading">Implementaciones exitosas</h3>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 counter-item">
                    <div class="single-counter">
                        <div class="counter-contents">
                            <h2>
                                <span>+</span><span class="counter-number">10</span> <span>mil</span>
                            </h2>
                            <h3 class="counter-heading">Soportes</h3>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 counter-item">
                    <div class="single-counter">
                        <div class="counter-contents">
                            <h2>
                                <span>+</span><span class="counter-number">500</span> <span>mil</span>
                            </h2>
                            <h3 class="counter-heading">Desarrollos</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Counter Section -->

    <!-- Start Team Section -->
    {% set equipo = [
        {'nombre': 'Mario Estrada', 'cargo': 'CEO e investigador'},
        {'nombre': 'Sebastián Orozco', 'cargo': 'Líder facilitador'},
        {'nombre': 'Carolina Sánchez', 'cargo': 'Gestión administrativa'},
        {'nombre': 'Angie Carolina', 'cargo': 'Líder de implementación'},
        {'nombre': 'Sebastián Hoyos', 'cargo': 'Líder frontend'},
        {'nombre': 'Karina Vásquez', 'cargo': 'Soporte técnico y consultoría'},
        {'nombre': 'Julio Montoya', 'cargo': 'Soporte técnico y consultoría'},
    ] %}
    <section class="team-area section-padding">
        <div class="container">
            <div class="section-title">
                <span class="seccion-etiqueta">Equipo</span>
                <h2>Miembros del equipo</h2>
                <p>Las personas que acompañan la implementación, el soporte y la evolución de sus soluciones.</p>
            </div>
            <div class="row justify-content-center">
                {% for miembro in equipo %}
                    {% set partes = miembro.nombre|split(' ') %}
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="equipo-tarjeta">
                            <div class="equipo-iniciales" aria-hidden="true">
                                {{- partes|first|first ~ partes|last|first -}}
                            </div>
                            <h3>{{ miembro.nombre }}</h3>
                            <span>{{ miembro.cargo }}</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    <!-- End Team Section -->

    <!-- Start Testimonial Section -->
    {% set testimonios = [
        {
            'texto': 'En Semántica hemos encontrado un aliado estratégico ajustado a nuestras necesidades: atiende las solicitudes y brinda soluciones oportunamente. En Coordinar Seguridad nos sentimos respaldados para dar tranquilidad a nuestros clientes y continuar avanzando en la transformación digital.',
            'nombre': 'Jhon F. Castaño', 'cargo': 'Gerente', 'empresa': 'Coordinar Seguridad',
            'foto': 'JhonFCastano.jpg'
        },
        {
            'texto': 'Con la implementación de Semántica hemos incrementado el control de nuestros procesos y logrado el cálculo de los costos ocultos. Hoy podemos ofrecer trazabilidad de la información en el tiempo y garantía de los datos en un proceso de mejora continua.',
            'nombre': 'Javier H. Berrío de Pombo', 'cargo': 'Gerente General', 'empresa': 'Grupo Vimarco',
            'foto': 'JavierBerrio.jpg'
        },
        {
            'texto': 'Semántica Digital es garantía de tranquilidad y respaldo en todos nuestros procesos corporativos. Nos han acompañado como aliados casi desde el nacimiento de la empresa y han superado nuestras expectativas en cada una de nuestras necesidades.',
            'nombre': 'Andrés Montoya', 'cargo': 'Gerente General', 'empresa': 'Energy Logística',
            'foto': 'AndresMontoya.jpg'
        },
        {
            'texto': 'Encontrar un respaldo tecnológico que apoye los procesos de ejecución y control es de vital importancia. Con Semántica tenemos la garantía de una mejora continua, aplicativos de fácil manejo, seguridad en la información y herramientas actualizadas.',
            'nombre': 'Diana Zapata', 'cargo': 'Gerente Administrativa', 'empresa': 'Invivo',
            'foto': 'DianaZapata.jpg'
        },
    ] %}
    <section class="testimonial-section bg-grey section-padding">
        <div class="container">
            <div class="section-title">
                <span class="seccion-etiqueta">Testimonios</span>
                <h2>Lo que dicen nuestros clientes</h2>
                <p>Empresas de distintos sectores que confían en Semantica para operar y crecer.</p>
            </div>
            <div class="testimonial-slider owl-carousel owl-theme">
                {% for t in testimonios %}
                    <figure class="testimonio">
                        <span class="testimonio-empresa">{{ t.empresa }}</span>
                        <div class="testimonio-texto">
                            <p>{{ t.texto }}</p>
                        </div>
                        <figcaption class="testimonio-autor">
                            <img src="{{ asset('landingPage/img/client/' ~ t.foto) }}" alt="{{ t.nombre }}"
                                 width="52" height="52" loading="lazy">
                            <div>
                                <h3>{{ t.nombre }}</h3>
                                <span>{{ t.cargo }}</span>
                            </div>
                        </figcaption>
                    </figure>
                {% endfor %}
            </div>
        </div>
    </section>
    <!-- End Testimonial Section -->

    <!-- Start Hire Section -->
    <section class="hire-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 offset-lg-2 col-md-12">
                    <div class="hire-content">
                        <h2>¿Qué proyecto tiene en mente hoy?</h2>
                        <p>Desde nuestra fábrica de soluciones atendemos de forma integral sus proyectos de tecnología:
                            nube, infraestructura, desarrollo a la medida, apps móviles y bases de datos.</p>
                        <div class="hire-btn">
                            <a class="default-btn-one" href="{{ path('contacto') }}">Contáctenos <span></span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- End Hire Section -->

    <!-- Start Partner Logo Section -->
    <div class="partner-area bg-white">
        <div class="container">
            <div id="partner-carousel" class="partner-carousel owl-carousel owl-theme owl-loaded">
                <div class="partner-slide-item">
                    <a href="#0">
                        <img src="{{ asset('landingPage/img/partner-logo/IC1.jpg') }}"  alt="partner-image">
                    </a>
                </div>
                <div class="partner-slide-item">
                    <a href="#0">
                        <img src="{{ asset('landingPage/img/partner-logo/IC2.jpg') }}" alt="partner-image">
                    </a>
                </div>
                <div class="partner-slide-item">
                    <a href="#0">
