                    {% else %}
                        <img src="{{ asset('imagenes/semantica/logo-claro.png') }}" class="white-logo" alt="Semantica Digital">
                        <img src="{{ asset('imagenes/semantica/logo.png') }}" class="black-logo" alt="Semantica Digital">
