<!-- Start Navbar Area -->
<div class="navbar-area{% if oscuro %} navbar-oscura{% endif %}">
    <div class="techmax-responsive-nav index-navber-responsive">
        <div class="container">
            <div class="techmax-responsive-menu">
                <div class="logo">
                    <a href="{{ path('inicio') }}">
                        {% if oscuro == false %}
                            <img src="{{ asset('imagenes/semantica/logo.png') }}" class="white-logo" alt="Semantica Digital">
                            <img src="{{ asset('imagenes/semantica/logo.png') }}" class="black-logo" alt="Semantica Digital">
                        {% else %}
                            <img src="{{ asset('imagenes/semantica/logo-claro.png') }}" class="white-logo" alt="Semantica Digital">
                            <img src="{{ asset('imagenes/semantica/logo.png') }}" class="black-logo" alt="Semantica Digital">
                        {% endif %}
                    </a>
                </div>
            </div>
        </div>
    </div>
