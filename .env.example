# Plantilla de variables de entorno de hasio.
#
# Copiala a .env y rellena los valores:
#     cp .env.example .env
#
# .env esta en .gitignore, asi que los valores reales NO se versionan.
# Este archivo si se versiona: mantenlo sincronizado cuando agregues o
# quites una variable del codigo.
#
# Orden de carga (gana el ultimo):
#     .env  ->  .env.local  ->  .env.$APP_ENV  ->  .env.$APP_ENV.local
# Las variables reales del sistema ganan sobre cualquier archivo .env.

###> symfony/framework-bundle ###
# dev | prod. APP_DEBUG se deriva de APP_ENV si no se define.
APP_ENV=dev
# Cadena aleatoria. Generar con: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL publica del sitio, para generar URLs fuera de una peticion (comandos).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> hasio/carbono ###
# URL base de Carbono (mesa de ayuda). DEBE terminar en "/": las rutas del
# codigo van sin "/" inicial y se concatenan a ella (ver src/Utilidades/).
# Se usa para la API y para los enlaces de Log in y Soporte del menu.
# Ejemplo local: BASE_CARBONO="http://localhost/carbono/public/index.php/"
BASE_CARBONO=
# Token de la API de Carbono, viaja como "Authorization: Bearer ...". Se crea
# en Carbono con: php bin/console app:api-token crear hasio
CARBONO_TOKEN=
###< hasio/carbono ###

###> hasio/recaptcha ###
# reCAPTCHA v3 de los formularios de contacto y eventos. La clave del sitio es
# publica (va en el HTML); la secreta solo la usa el servidor para validar.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
###< hasio/recaptcha ###
